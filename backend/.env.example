# ==============================================================================
# PartnerOn Backend Environment Variables Example (PostgreSQL Only)
# ==============================================================================

DJANGO_SECRET_KEY=development-only-change-me-secure-key-partneron

EMAIL_HOST_USER=fbkr.rpa@gmail.com
EMAIL_HOST_PASSWORD=your_smtp_app_password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Partneron 파트너온 <admin@partneron.co.kr>

# PostgreSQL Database Configuration
POSTGRES_DB=partneron
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
