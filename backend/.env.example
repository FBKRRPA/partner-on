# ==============================================================================
# PartnerOn Backend Environment Variables Configuration Template
# ==============================================================================

# 🔒 Django Secret Key Configuration
DJANGO_SECRET_KEY=development-only-change-me-secure-key-partneron

# ✉️ Email (SMTP) Real Mail Sender Configuration
# (Set EMAIL_HOST_USER and EMAIL_HOST_PASSWORD to enable real email sending)
EMAIL_HOST_USER=admin@partneron.co.kr
EMAIL_HOST_PASSWORD=your-smtp-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Partneron 파트너온 <no-reply@partneron.co.kr>

# 🗄️ Database Configuration (Set USE_SQLITE=false to use PostgreSQL)
USE_SQLITE=true
POSTGRES_DB=partneron
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
